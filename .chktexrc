# chktex configuration for modern_cv
#
# Suppressed warnings:
#  1  - Command terminated with space
#  8  - Wrong length of dash (German uses different dash conventions)
# 24  - Delete this space to maintain correct paginating
# 36  - Parentheses/brackets don't match
# 44  - User Regex (custom commands)

CmdLine {
  -n 1
  -n 8
  -n 24
  -n 36
  -n 44
}
